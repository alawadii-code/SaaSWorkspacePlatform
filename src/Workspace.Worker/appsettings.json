{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Jwt": {
    "Issuer": "workspace-api",
    "Audience": "workspace-web"
  },
  "Queue": {
    "Provider": "redis",
    "ConnectionString": "localhost:6379",
    "KeyPrefix": "workspace:jobs",
    "PollIntervalMs": 500,
    "VisibilityTimeoutSeconds": 120
  },
  "Smtp": {
    "Enabled": true,
    "Host": "localhost",
    "Port": 1025,
    "UseStartTls": false,
    "FromAddress": "no-reply@workspace.local",
    "FromName": "Workspace",
    "TimeoutSeconds": 15
  },
  "Invitations": {
    "LifetimeDays": 7,
    "AcceptUrlTemplate": "http://localhost:5173/invitations/accept?token={token}",
    "ReconcileAfterSeconds": 60
  }
}
