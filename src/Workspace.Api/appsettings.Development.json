{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Workspace": "Debug",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "Auth": {
    "// UseSecureCookies": "Off for plain-HTTP localhost only. Startup refuses this outside Development.",
    "UseSecureCookies": false,
    "// ReturnRefreshTokenInBody": "Convenience for curl and the API reference page.",
    "ReturnRefreshTokenInBody": true
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Queue": {
    "Provider": "redis",
    "ConnectionString": "localhost:6379"
  },
  "Smtp": {
    "Enabled": true,
    "Host": "localhost",
    "Port": 1025
  }
}
