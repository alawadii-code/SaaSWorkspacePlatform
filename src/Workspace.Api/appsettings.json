{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Jwt": {
    "Issuer": "workspace-api",
    "Audience": "workspace-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Auth": {
    "RefreshCookieName": "workspace_rt",
    "UseSecureCookies": true,
    "ReturnRefreshTokenInBody": false,
    "CookiePath": "/api/auth"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "Enabled": true,
    "AuthPerMinute": 10,
    "InvitationLookupPerMinute": 20,
    "GlobalPerMinute": 600
  },
  "Queue": {
    "Provider": "redis",
    "ConnectionString": "localhost:6379",
    "KeyPrefix": "workspace:jobs",
    "PollIntervalMs": 500,
    "VisibilityTimeoutSeconds": 120
  },
  "Smtp": {
    "Enabled": false,
    "Host": "localhost",
    "Port": 1025,
    "UseStartTls": false,
    "FromAddress": "no-reply@workspace.local",
    "FromName": "Workspace",
    "TimeoutSeconds": 15
  },
  "Invitations": {
    "LifetimeDays": 7,
    "AcceptUrlTemplate": "http://localhost:5173/invitations/accept?token={token}",
    "ReconcileAfterSeconds": 60
  }
}
