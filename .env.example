# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
#   cp .env.example .env
#
# Generate the two secrets below with:
#
#   openssl rand -base64 48      # JWT_SIGNING_KEY
#   openssl rand -base64 24      # POSTGRES_PASSWORD
#
# Nothing in this file is a real credential.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_USER=workspace
POSTGRES_PASSWORD=replace-with-a-generated-password
POSTGRES_DB=workspace
# Host port the database is published on, so tests can reach it.
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Tokens
# ---------------------------------------------------------------------------
# At least 32 characters. The API refuses to start outside Development if this
# is missing or still set to the example value below.
JWT_SIGNING_KEY=replace-with-a-32-byte-minimum-random-secret
JWT_ISSUER=workspace-api
JWT_AUDIENCE=workspace-web
# Short-lived: roles are re-read from the database on every request, but
# identity is not, so this bounds how long a disabled account keeps working.
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=14

# Secure cookies require HTTPS. Compose serves plain HTTP on localhost, so this
# is false there; any real deployment must set it to true, and the API refuses
# to start with it false outside Development.
AUTH_USE_SECURE_COOKIES=false

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
API_PORT=5080
WEB_PORT=8080
MAILPIT_UI_PORT=8025

# Where the invitation email sends people. Must match how the frontend is
# reached, including the port.
INVITATION_ACCEPT_URL=http://localhost:8080/invitations/accept?token={token}

# ---------------------------------------------------------------------------
# Outbound email
# ---------------------------------------------------------------------------
# Compose points the worker at Mailpit, which catches everything locally and
# sends nothing. A real deployment replaces the host, port and credentials —
# and sets Smtp__Username / Smtp__Password through the environment, never here.
SMTP_FROM_ADDRESS=no-reply@workspace.local
SMTP_FROM_NAME=Workspace

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------
# The integration tests create and drop their own database on this server.
WORKSPACE_TEST_POSTGRES=Host=localhost;Port=5432;Username=workspace;Password=replace-with-a-generated-password;Database=postgres
